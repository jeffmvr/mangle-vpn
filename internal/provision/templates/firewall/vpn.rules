-t filter -A INPUT -i {{ .Interface }} -p {{ .Protocol }} --dport {{ .Port }} -m conntrack --ctstate NEW -j ACCEPT
-t filter -A INPUT -i tun0 -j ACCEPT
-t filter -A OUTPUT -o tun0 -j ACCEPT
-t filter -A FORWARD -s {{ .Subnet }} -j MangleVPN
-t nat -A POSTROUTING -o {{ .NATInterface }} -s {{ .Subnet }} -j MASQUERADE
{{- range .Nameservers }}
-t filter -A MangleVPN -i tun0 -d {{ . }} -p tcp --dport 53 -j ACCEPT
-t filter -A MangleVPN -i tun0 -d {{ . }} -p udp --dport 53 -j ACCEPT
{{- end }}
{{- range .LocalAddresses }}
-t filter -A MangleVPN -i tun0 -d {{ . }} -j ACCEPT
{{- end }}
{{- if .DeviceToDevice }}
-t filter -A MangleVPN -i tun0 -o tun0 -d {{ .Subnet }} -j ACCEPT
{{- end }}
-t filter -A MangleVPN -i tun0 -j MangleVPN_Clients
-t filter -A MangleVPN -j DROP
